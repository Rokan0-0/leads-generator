# LeadPulse NG API Configuration
# Get free API key from https://serper.dev (2,500 free queries)
SERPER_API_KEY=your_serper_key_here

# Google Cloud API Key with "Places API (New)" enabled (Optional)
GOOGLE_API_KEY=your_google_cloud_places_key

# Optional: Google Gemini API Key for dynamic AI pitch angle generation
GEMINI_API_KEY=your_gemini_api_key

# Optional: Turso Serverless SQLite (for 24/7 cloud persistence on Render)
# Get free from https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Google Sheets Sync credentials
# Path to service account JSON (e.g. service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_NAME=LeadPulse NG Leads
